{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client", "@types/node", "@vue-macros/reactivity-transform/macros-global"],

    "jsx": "preserve",
    "jsxImportSource": "vue-jsx-vapor",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "maxNodeModuleJsDepth": 0,

    "baseUrl": ".",
    "paths": {
      "@vc-com/*": ["packages/*/src/index.ts", "packages/*/src/index.tsx", "packages/*/src"],
      "@/*": ["playground/*"],
      "@vc-com/util/lib/*": ["packages/util/src/*"],
      "@vc-com/render/*": ["packages/render/src/*"],
      "@vc-com/resize-observer/*": ["packages/resize-observer/src/*"],
      "@vc-com/motion/*": ["packages/motion/src/*"],
      "@vc-com/portal/*": ["packages/portal/src/*"],
      "@vc-com/trigger/*": ["packages/trigger/src/*"],
      "@vc-com/tooltip/*": ["packages/tooltip/src/*"],
      "@vc-com/tour/*": ["packages/tour/src/*"],
      "@vc-com/virtual-list/*": ["packages/virtual-list/src/*"],
      "@vc-com/async-validator/*": ["packages/async-validator/src/*"],
      "@vc-com/mini-decimal/*": ["packages/mini-decimal/src/*"],
      "@vc-com/overflow/*": ["packages/overflow/src/*"],
      "@vc-com/mutate-observer/*": ["packages/mutate-observer/src/*"],
      "@vc-com/input/*": ["packages/input/src/*"],
      "@vc-com/select/*": ["packages/select/src/*"],
      "@vc-com/checkbox/*": ["packages/checkbox/src/*"],
      "@vc-com/collapse/*": ["packages/collapse/src/*"],
      "@vc-com/slider/*": ["packages/slider/src/*"],
      "@vc-com/input-number/*": ["packages/input-number/src/*"],
      "@vc-com/color-picker/*": ["packages/color-picker/src/*"],
      "@vc-com/tree/*": ["packages/tree/src/*"],
      "@vc-com/tree-select/*": ["packages/tree-select/src/*"],
      "@vc-com/textarea/*": ["packages/textarea/src/*"],
      "@vc-com/dropdown/*": ["packages/dropdown/src/*"],
      "@vc-com/menu/*": ["packages/menu/src/*"],
      "@vc-com/mentions/*": ["packages/mentions/src/*"],
      "@vc-com/dialog/*": ["packages/dialog/src/*"],
      "@vc-com/drawer/*": ["packages/drawer/src/*"],
      "@vc-com/notification/*": ["packages/notification/src/*"],
      "@vc-com/picker/*": ["packages/picker/src/*"],
      "@vc-com/progress/*": ["packages/progress/src/*"],
      "@vc-com/qrcode/*": ["packages/qrcode/src/*"],
      "@vc-com/rate/*": ["packages/rate/src/*"],
      "@vc-com/segmented/*": ["packages/segmented/src/*"],
      "@vc-com/steps/*": ["packages/steps/src/*"],
      "@vc-com/switch/*": ["packages/switch/src/*"],
      "@vc-com/tabs/*": ["packages/tabs/src/*"],
      "@vc-com/upload/*": ["packages/upload/src/*"],
      "@vc-com/form/*": ["packages/form/src/*"]
    }
  },
  "include": [
    "playground/**/*.ts",
    "playground/**/*.tsx",
    "playground/**/*.vue",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "packages/**/*.vue"
  ]
}
